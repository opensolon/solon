<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CUSTOM_XML" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <root level="DEBUG">
        <appender-ref ref="CUSTOM_XML"/>
    </root>
</configuration>
